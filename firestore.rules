
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // Permitir acceso total si el usuario está autenticado (incluyendo anónimos) para prototipado rápido
    function isAuthorized() {
      return isSignedIn();
    }

    function isPanelVisible(data) {
      return data != null && data.visible == true;
    }

    function isCombinationApproved(data) {
      return data != null && data.isApproved == true;
    }

    // --- Collection Rules ---

    match /panels/{panelId} {
      // Permitir lectura si es visible públicamente O si el usuario está autorizado
      allow get, list: if isAuthorized() || isPanelVisible(resource.data);
      
      // Permitir escritura si el usuario está autorizado
      allow create, update, delete: if isAuthorized();
    }

    match /combinations/{combinationId} {
      allow get, list: if isAuthorized() || isCombinationApproved(resource.data);
      allow create, update, delete: if isAuthorized();
    }

    match /roles_admin/{adminUid} {
      allow get: if isSignedIn() && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false; 
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
