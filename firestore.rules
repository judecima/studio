rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && (getUserRole() == 'admin');
    }

    function isAdministradorOrAdmin() {
      return isSignedIn() && (getUserRole() in ['admin', 'administrador']);
    }

    function isAuthorized() {
      return isSignedIn();
    }

    function isPanelVisible(data) {
      return data != null && data.visible == true;
    }

    function isCombinationApproved(data) {
      return data != null && data.isApproved == true;
    }

    // --- Collection Rules ---

    match /users/{userId} {
       // El usuario puede leer su propio perfil. Admin lee todos.
       allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
       // Permitir crear su perfil base 'cliente' al loguearse la primera vez.
       allow create: if isSignedIn() && request.auth.uid == userId && request.resource.data.role == 'cliente';
       // Solo el Superadmin puede actualizar (ej. ascender) a otros.
       allow update, delete: if isAdmin();
    }

    match /panels/{panelId} {
      // Permitir lectura si es visible públicamente O si el usuario está autorizado
      allow get, list: if isAuthorized() || isPanelVisible(resource.data);
      // Permitir escritura si el usuario está autorizado
      allow create, update, delete: if isAuthorized();
    }

    match /catalog_products/{productId} {
      // El catálogo es de lectura pública
      allow read: if true;
      // Scrapers y mutaciones solo por administradores
      allow write: if isAdministradorOrAdmin();
    }

    match /combinations/{combinationId} {
      allow get, list: if isAuthorized() || isCombinationApproved(resource.data);
      allow create, update, delete: if isAuthorized();
    }

    match /roles_admin/{adminUid} {
      allow read, write: if false; 
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
