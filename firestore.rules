
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // Permitir acceso temporal para prototipado si el usuario está autenticado
    function isAuthorized() {
      return isSignedIn(); // Simplificado para MVP, permite a cualquier usuario autenticado (incluyendo anónimos)
    }

    function isPanelVisible(data) {
      return data != null && data.visible == true;
    }

    function isCombinationApproved(data) {
      return data != null && data.isApproved == true;
    }

    // --- Collection Rules ---

    match /panels/{panelId} {
      allow get, list: if isPanelVisible(resource.data) || isAuthorized();
      
      // Asegurar que el ID del documento coincida con el campo 'id' del objeto
      allow create: if isAuthorized() && request.resource.data.id == panelId;
      
      allow update: if isAuthorized() && request.resource.data.id == resource.data.id;
      
      allow delete: if isAuthorized();
    }

    match /combinations/{combinationId} {
      allow get, list: if isCombinationApproved(resource.data) || isAuthorized();
      
      allow create: if isAuthorized() && request.resource.data.id == combinationId;
      
      allow update: if isAuthorized() && request.resource.data.id == resource.data.id;
      
      allow delete: if isAuthorized();
    }

    match /roles_admin/{adminUid} {
      allow get: if isSignedIn() && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false; 
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
