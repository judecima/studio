rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Permitir al scraper y a los usuarios guardar y leer imágenes
    match /products/{allPaths=**} {
      allow read, write: if true;
    }
    
    // Regla de seguridad por defecto para el resto del bucket
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
